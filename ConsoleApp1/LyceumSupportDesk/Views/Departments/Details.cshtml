@model Department

@{
    ViewData["Title"] = $"{Model.Name} Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@Model.Name Department</h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-1">Edit Name</a>
            <a asp-action="Index" class="btn btn-secondary">Back to Departments</a>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header text-white" style="background-color: var(--loa-blue, #0d6efd);">
            <h5 class="mb-0">Staff Members in @Model.Name</h5>
        </div>
        <div class="card-body">
            @if (Model.Employees != null && Model.Employees.Any())
            {
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role / Title</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model.Employees)
                        {
                            <tr>
                                <td class="fw-bold">@emp.FirstName @emp.LastName</td>
                                <td><a href="mailto:@emp.Email">@emp.Email</a></td>
                                <td><span class="badge bg-dark">Staff</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted text-center my-3">No employees currently assigned to this department.</p>
            }
        </div>
    </div>
</div>