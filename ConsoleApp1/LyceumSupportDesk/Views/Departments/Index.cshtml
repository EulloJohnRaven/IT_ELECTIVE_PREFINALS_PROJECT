@model IEnumerable<DepartmentSummaryViewModel>

@{
    ViewData["Title"] = "Department Directory";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Department Directory & Workload Summary</h2>
        <a asp-action="Create" class="btn btn-primary">+ Add New Department</a>
    </div>

    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Department Name</th>
                <th>Assigned Staff</th>
                <th>Active Tickets</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var dept in Model)
                {
                    <tr>
                        <td>#@dept.Id</td>
                        <td class="fw-bold">@dept.Name</td>
                        <td>
                            <span class="badge bg-secondary">@dept.EmployeeCount Staff Members</span>
                        </td>
                        <td>
                            <span class="badge @(dept.ActiveTicketsCount > 5 ? "bg-danger" : "bg-warning text-dark")">
                                @dept.ActiveTicketsCount Active
                            </span>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@dept.Id" class="btn btn-info">View Staff</a>
                                <a asp-action="Edit" asp-route-id="@dept.Id" class="btn btn-warning">Edit</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No departments found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>