@model IEnumerable<Tag>

@{
    ViewData["Title"] = "System Tags";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Tag Management Directory</h2>
        <a asp-action="Create" class="btn btn-primary">+ Create New Tag</a>
    </div>

    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Tag Name</th>
                <th>Description</th>
                <th>Associated Tickets</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var tag in Model)
                {
                    <tr>
                        <td class="fw-bold">
                            <span class="badge bg-secondary px-2 py-1">@tag.Name</span>
                        </td>
                        <td>@(string.IsNullOrEmpty(tag.Description) ? "N/A" : tag.Description)</td>
                        <td>
                            <span class="badge bg-info text-dark">@(tag.TicketTags?.Count ?? 0) Tickets</span>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@tag.Id" class="btn btn-sm btn-warning">Edit</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">No tags created yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>