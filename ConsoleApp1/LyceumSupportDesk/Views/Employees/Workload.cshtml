@model IEnumerable<LyceumSupportDesk.Models.ViewModels.EmployeeWorkloadViewModel>

@{
    ViewData["Title"] = "Employee Workload Analytics";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-graph-up-arrow"></i> Employee Workload Analytics</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Directory</a>
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body">
            <form method="get" asp-action="Workload" class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-bold small text-secondary">Search Employee</label>
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Search by name..." />
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-bold small text-secondary">Filter by Department</label>
                    <select name="departmentId" asp-items="ViewBag.Departments" class="form-select">
                        <option value="">All Departments</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-dark w-100">Analyze</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Analytics Dashboard -->
    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-primary">@item.FullName</h5>
                            <h6 class="card-subtitle mb-3 text-muted">@item.DepartmentName</h6>

                            <ul class="list-group list-group-flush mb-3">
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    Active Tickets
                                    <span class="badge bg-warning text-dark rounded-pill">@item.ActiveTickets</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    Resolved Tickets
                                    <span class="badge bg-success rounded-pill">@item.ResolvedTickets</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 fw-bold">
                                    Total Assigned
                                    <span class="badge bg-dark rounded-pill">@item.TotalTickets</span>
                                </li>
                            </ul>

                            <!-- Visual Capacity Bar -->
                            <p class="small text-muted mb-1 fw-bold">Active Load Capacity (vs 10)</p>
                            <div class="progress" style="height: 10px;">
                                @{
                                    var progressClass = item.ActiveTickets > 7 ? "bg-danger"
                                                      : item.ActiveTickets > 4 ? "bg-warning"
                                                      : "bg-success";
                                    var width = item.WorkloadPercentage > 100 ? 100 : item.WorkloadPercentage;
                                }
                                <div class="progress-bar @progressClass" role="progressbar" style="width: @width%" aria-valuenow="@width" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted py-5">
                <p>No workload data found for the selected filters.</p>
            </div>
        }
    </div>
</div>