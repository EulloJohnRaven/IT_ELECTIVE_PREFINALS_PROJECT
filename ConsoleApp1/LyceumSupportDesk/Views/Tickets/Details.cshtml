@model Ticket

@{
    ViewData["Title"] = "Ticket Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Ticket #@Model.Id Details</h2>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-dark text-white" style="background-color: var(--loa-blue) !important;">
            <h4 class="mb-0">@Model.Subject</h4>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Customer:</strong> @(Model.Customer?.CompanyName ?? "N/A")<br />
                    <strong>Contact:</strong> @(Model.Customer?.ContactName ?? "N/A")<br />
                    <strong>Category:</strong> @(Model.Category?.Name ?? "N/A")
                </div>
                <div class="col-md-6 text-md-end">
                    <strong>Status:</strong> <span class="badge bg-info text-dark">@(Model.Status?.Name ?? "N/A")</span><br />
                    <strong>Priority:</strong> <span class="badge bg-warning text-dark">@(Model.Priority?.Name ?? "N/A")</span><br />
                    <strong>Created:</strong> @Model.CreatedAt
                </div>
            </div>

            <hr />

            <h5>Description</h5>
            <div class="p-3 bg-light rounded border">
                @Model.Description
            </div>
        </div>
    </div>
</div>