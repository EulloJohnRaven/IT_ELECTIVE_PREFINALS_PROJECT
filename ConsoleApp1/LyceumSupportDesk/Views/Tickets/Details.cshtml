@model Ticket

@{
    ViewData["Title"] = $"Ticket #{Model.Id} Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Ticket #@Model.Id: @Model.Subject</h2>
            <p class="text-muted mb-0">Detailed view, collaborative team management, and internal logs.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Tickets</a>
    </div>

    <div class="row">
        <!-- Ticket Information Card -->
        <div class="col-md-7 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Ticket Information</h5>
                </div>
                <div class="card-body">
                    <p><strong>Customer:</strong> @Model.Customer?.CompanyName (@Model.Customer?.ContactName)</p>
                    <p><strong>Category:</strong> @(Model.Category?.Name ?? "N/A")</p>
                    <p>
                        <strong>Priority:</strong>
                        <span class="badge bg-secondary">@(Model.Priority?.Name ?? "N/A")</span>
                    </p>
                    <p>
                        <strong>Current Status:</strong>
                        <span class="badge bg-primary">@(Model.Status?.Name ?? "Open")</span>
                    </p>
                    <hr />
                    <p class="fw-bold mb-1">Description / Request:</p>
                    <div class="p-3 bg-light rounded border">
                        @Model.Description
                    </div>

                    <!-- Status Update Form -->
                    <form asp-action="UpdateStatus" method="post" class="mt-4 row g-2 align-items-center">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="col-md-8">
                            <label class="form-label fw-bold small text-secondary">Change Ticket Status</label>
                            <select name="statusId" asp-items="ViewBag.Statuses" class="form-select form-select-sm"></select>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button type="submit" class="btn btn-sm btn-dark w-100 mt-4">Update Status</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Assigned Staff / Collaboration Panel -->
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header text-white" style="background-color: var(--loa-blue, #0d6efd);">
                    <h5 class="mb-0"><i class="bi bi-people-fill"></i> Assigned Team Members</h5>
                </div>
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        @if (Model.TicketAssignments != null && Model.TicketAssignments.Any())
                        {
                            <ul class="list-group list-group-flush mb-3">
                                @foreach (var assignment in Model.TicketAssignments)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <div>
                                            <span class="fw-bold d-block">@assignment.Employee?.FirstName @assignment.Employee?.LastName</span>
                                            <small class="text-muted">@(assignment.Employee?.Department?.Name ?? "Unassigned Dept")</small>
                                        </div>
                                        <form asp-action="RemoveAssignment" method="post" class="mb-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ticketId" value="@Model.Id" />
                                            <input type="hidden" name="employeeId" value="@assignment.EmployeeId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove Assignee">✕</button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted text-center my-3">No staff members currently assigned to this ticket.</p>
                        }
                    </div>

                    <!-- Add Assignee Form -->
                    <div class="border-top pt-3 mt-3">
                        <form asp-action="AddAssignment" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ticketId" value="@Model.Id" />
                            <label class="form-label fw-bold small text-secondary">Assign Additional Staff</label>
                            <div class="input-group input-group-sm">
                                <select name="employeeId" asp-items="ViewBag.EmployeeList" class="form-select" required>
                                    <option value="">-- Select Staff Member --</option>
                                </select>
                                <button type="submit" class="btn btn-primary">Assign</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Ticket Notes & Activity Log Section -->
    <div class="row">
        <div class="col-12 mb-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="bi bi-chat-square-text-fill"></i> Internal Notes & Activity Log</h5>
                </div>
                <div class="card-body">
                    <!-- Post Note Form -->
                    <form asp-action="AddNote" method="post" class="mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" value="@Model.Id" />
                        <div class="mb-3">
                            <label for="content" class="form-label fw-bold small text-secondary">Add Troubleshooting Note or Update</label>
                            <textarea name="content" class="form-control" rows="3" placeholder="Type internal notes, diagnostic steps, or customer comments here..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary">Post Note</button>
                    </form>

                    <hr />

                    <!-- Notes Timeline / Feed -->
                    @if (Model.TicketNotes != null && Model.TicketNotes.Any())
                    {
                        <div class="timeline">
                            @foreach (var note in Model.TicketNotes.OrderByDescending(n => n.CreatedAt))
                            {
                                <div class="card bg-light border-0 mb-3 shadow-sm">
                                    <div class="card-body py-2 px-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <small class="text-muted"><i class="bi bi-clock"></i> @note.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</small>
                                            <span class="badge bg-secondary">Internal Note</span>
                                        </div>
                                        <p class="mb-0 text-dark">@note.Content</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center my-3">No internal notes logged for this ticket yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>