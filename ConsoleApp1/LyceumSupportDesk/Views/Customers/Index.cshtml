@model IEnumerable<Customer>

@{
    ViewData["Title"] = "Customers Directory";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Customer Directory</h2>
        <a asp-action="Create" class="btn btn-primary">+ Add New Customer</a>
    </div>

    <!-- Search Bar -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-md-9">
                    <label class="form-label fw-bold small text-secondary">Search Customer</label>
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Search by company name, contact, or email..." />
                </div>
                <div class="col-md-3 d-flex gap-1">
                    <button type="submit" class="btn btn-dark w-100">Search</button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Reset">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table -->
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Company Name</th>
                <th>Contact Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.CompanyName</td>
                        <td>@item.ContactName</td>
                        <td>@item.Email</td>
                        <td>@(string.IsNullOrEmpty(item.Phone) ? "N/A" : item.Phone)</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-1">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">No customers found matching the search criteria.</td>
                </tr>
            }
        </tbody>
    </table>
</div>