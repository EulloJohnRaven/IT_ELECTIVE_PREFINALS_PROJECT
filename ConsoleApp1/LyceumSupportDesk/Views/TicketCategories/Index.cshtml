@model IEnumerable<TicketCategory>

@{
    ViewData["Title"] = "Ticket Categories";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Ticket Categories Directory</h2>
        <a asp-action="Create" class="btn btn-primary">+ Add New Category</a>
    </div>

    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Category Name</th>
                <th>Description</th>
                <th>Parent Category</th>
                <th>Subcategories</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.Name</td>
                        <td>@(string.IsNullOrEmpty(item.Description) ? "N/A" : item.Description)</td>
                        <td>
                            @if (item.ParentCategory != null)
                            {
                                <span class="badge bg-secondary">@item.ParentCategory.Name</span>
                            }
                            else
                            {
                                <span class="text-muted small">Root Category</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-info text-dark">@(item.Subcategories?.Count ?? 0) Sub-items</span>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Details</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No categories configured yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>