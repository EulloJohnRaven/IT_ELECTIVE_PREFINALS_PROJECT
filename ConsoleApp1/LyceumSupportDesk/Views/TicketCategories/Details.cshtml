@model TicketCategory

@{
    ViewData["Title"] = $"{Model.Name} Category Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Category: @Model.Name</h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-1">Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back to Categories</a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Category Metadata</h5>
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>Name:</strong> @Model.Name</p>
                    <p class="mb-2"><strong>Description:</strong> @(string.IsNullOrEmpty(Model.Description) ? "N/A" : Model.Description)</p>
                    <p class="mb-0"><strong>Parent Category:</strong> @(Model.ParentCategory?.Name ?? "None (Root)")</p>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-header text-white" style="background-color: var(--loa-blue, #0d6efd);">
                    <h5 class="mb-0">Subcategories</h5>
                </div>
                <div class="card-body">
                    @if (Model.Subcategories != null && Model.Subcategories.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var sub in Model.Subcategories)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span class="fw-bold">@sub.Name</span>
                                    <a asp-action="Details" asp-route-id="@sub.Id" class="btn btn-sm btn-outline-primary">View</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted text-center my-3">No subcategories defined under this category.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>